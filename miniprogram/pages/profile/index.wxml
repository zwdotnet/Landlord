<view class="mist"/><t-navbar placeholder="{{true}}" id="app-header" title="我的" left-arrow="{{false}}" delta="{{0}}" bind:go-back="goBack" />

<view class="screen with-tabs profile-screen"><view wx:if="{{loading}}" class="loading">正在读取资料…</view><view wx:elif="{{error}}" class="error">{{error}}<t-button bind:tap="refresh" class="action-refresh">重试</t-button></view><block wx:elif="{{profile}}">
 <view class="profile-header"><view class="avatar profile-avatar"><t-icon name="user" size="35px"/></view><view class="profile-name">{{profile.name}}<view class="verified-label"><t-icon name="check-circle-filled" size="12px"/>已关联</view></view><view class="profile-account">{{phone || '租客账号'}} · #{{accountId}}</view></view>
 <view class="tenant-home-card glass"><view class="room-icon"><t-icon name="home" size="25px"/></view><view class="row-copy"><view class="row-title">{{profile.room_label || '房屋信息待补充'}}</view><view class="support">租约至 {{profile.endText}}</view></view><view class="tenant-status">{{profile.active ? '在租' : '历史'}}</view></view>
 <view class="section-heading">账号与联系</view><view class="white-panel contact-cell" bindtap="goContact"><view class="row-icon brand-icon"><t-icon name="mobile" size="21px"/></view><view class="row-copy"><view class="row-title">联系手机号</view><view class="support">{{phone || '未填写'}}</view></view><view class="edit-link">修改<t-icon name="chevron-right" size="14px"/></view></view>
 <view class="section-heading">我的租住</view><view class="white-panel profile-menu"><t-cell title="缴费记录与收据" left-icon="wallet" arrow borderless bind:tap="goPayments"/><view class="inset-rule"/><t-cell title="合同与签署件" left-icon="file-paste" arrow borderless bind:tap="goContracts"/></view>
 <view class="section-heading">租住登记资料</view><view class="white-panel surface tenant-archive"><view class="pair"><text class="label">档案手机号</text><text class="value">{{profile.phone || '未填写'}}</text></view><view class="pair"><text class="label">证件号码</text><text class="value">{{profile.id_card || '未填写'}}</text></view><view class="pair"><text class="label">登记地址</text><text class="value">{{profile.address || '未填写'}}</text></view><view class="pair"><text class="label">紧急联系人</text><text class="value">{{profile.emergency_contact || '未填写'}}</text></view><view class="pair"><text class="label">紧急联系电话</text><text class="value">{{profile.emergency_phone || '未填写'}}</text></view><view class="pair"><text class="label">登记押金</text><text>¥{{profile.depositText}}</text></view><view class="rule"/><view class="meta">计费方式</view><view class="note">{{profile.billing_summary || '请联系房东核对'}}</view></view>
 <view class="hint">{{profile.pending_change ? '资料修改申请正在等待房东审核。' : '租住登记资料如有误，请联系房东；账号联系手机号可在上方修改。'}}</view><view class="profile-privacy"><t-icon name="lock-on" size="14px"/>你的资料仅向本人和管理房东开放</view></block><view class="white-panel logout-cell" bindtap="logout">退出登录</view></view>

<app-nav id="app-navigation" role="tenant" current="profile" meters="{{canMeters}}" issue="{{canIssue}}" pending="{{hasPendingPayment}}" />
