<view class="mist"/><t-navbar placeholder="{{true}}" id="app-header" title="缴费记录" left-arrow="{{true}}" delta="{{0}}" bind:go-back="goBack" />
<view class="page"><view class="kicker">房东登记的线下实收</view>
  <view wx:if="{{loading}}" class="loading">正在读取缴费记录…</view><view wx:elif="{{error}}" class="error">{{error}}<t-button theme="light" size="large" block bind:tap="refresh" class="action-refresh">重新加载</t-button></view>
  <block wx:else>
    <view wx:if="{{!items.length}}" class="empty"><view class="empty-title">还没有缴费记录</view>房东登记实收后，这里会显示原始记录。</view>
    <view wx:for="{{items}}" wx:key="id" class="surface"><view class="row"><view class="list-title">{{item.kindText}}</view><text class="money {{item.kindText === '冲销' ? 'negative' : 'positive'}}">{{item.kindText === '冲销' ? '-' : '+'}} ¥{{item.amountText}}</text></view><view class="meta gap">{{item.dateText}}</view><view wx:if="{{item.note}}" class="note">{{item.note}}</view><view wx:if="{{item.voided_at}}" class="note negative">已冲销 · {{item.void_reason}}</view><view class="actions"><t-button theme="light" size="small" class="action-goBill small" bind:tap="goBill" data-id="{{item.bill_id}}">对应账单</t-button><t-button theme="light" size="small" wx:if="{{item.receipt_id}}" class="action-openFile small" bind:tap="openFile" data-path="/rental/portal/documents/{{item.receipt_id}}/file" disabled="{{opening}}">查看{{item.stateText}}</t-button></view><view wx:if="{{!item.receipt_id}}" class="hint">历史流水尚无归档 PDF</view></view>
    <view wx:if="{{total}}" class="pagination"><t-button theme="light" size="small" class="action-previous small" bind:tap="previous" disabled="{{page <= 1}}">上一页</t-button><text class="meta">{{page}} / {{pages}} 页 · 共 {{total}} 笔</text><t-button theme="light" size="small" class="action-next small" bind:tap="next" disabled="{{page >= pages}}">下一页</t-button></view>
  </block>
</view>
