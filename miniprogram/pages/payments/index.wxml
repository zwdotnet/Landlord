<view class="page"><view class="kicker">房东登记的线下实收</view><view class="title">缴费记录</view>
  <view wx:if="{{loading}}" class="loading">正在读取缴费记录…</view><view wx:elif="{{error}}" class="error">{{error}}<button bindtap="refresh">重新加载</button></view>
  <block wx:else>
    <view wx:if="{{!items.length}}" class="empty"><view class="empty-title">还没有缴费记录</view>房东登记实收后，这里会显示原始记录。</view>
    <view wx:for="{{items}}" wx:key="id" class="surface"><view class="row"><view class="list-title">{{item.kindText}}</view><text class="money {{item.kindText === '冲销' ? 'negative' : 'positive'}}">{{item.kindText === '冲销' ? '-' : '+'}} ¥{{item.amountText}}</text></view><view class="meta gap">{{item.dateText}}</view><view wx:if="{{item.note}}" class="note">{{item.note}}</view><view wx:if="{{item.voided_at}}" class="note negative">已冲销 · {{item.void_reason}}</view><view class="actions"><button class="small" bindtap="goBill" data-id="{{item.bill_id}}">对应账单</button><button wx:if="{{item.receipt_id}}" class="small" bindtap="openFile" data-path="/rental/portal/documents/{{item.receipt_id}}/file" disabled="{{opening}}">查看{{item.stateText}}</button></view><view wx:if="{{!item.receipt_id}}" class="hint">历史流水尚无归档 PDF</view></view>
    <view wx:if="{{total}}" class="pagination"><button class="small" bindtap="previous" disabled="{{page <= 1}}">上一页</button><text class="meta">{{page}} / {{pages}} 页 · 共 {{total}} 笔</text><button class="small" bindtap="next" disabled="{{page >= pages}}">下一页</button></view>
  </block>
</view>
