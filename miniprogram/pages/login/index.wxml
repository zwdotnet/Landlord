<view class="mist"/><t-navbar placeholder="{{true}}" id="app-header" title="" left-arrow="{{false}}" delta="{{0}}" bind:go-back="goBack" />

<view class="screen login-screen">
 <view class="brand-line"><view class="brand-mark"><t-icon name="home" size="28px"/></view><text>Landlord</text><view class="brand-divider"/><text class="brand-caption">租务管理</text></view>
 <view class="login-panel glass"><view class="role-switch"><view class="role-item {{mode === 'tenant' ? 'is-selected' : ''}}" data-mode="tenant" bindtap="switchMode">我是租客</view><view class="role-item {{mode === 'landlord' ? 'is-selected' : ''}}" data-mode="landlord" bindtap="switchMode">我是房东</view></view>
 <block wx:if="{{mode === 'landlord'}}"><view class="panel-title">欢迎回来</view><view class="support">登录已有的房东账号</view><view class="login-fields"><t-input label="账号" value="{{username}}" placeholder="输入账号" maxlength="100" disabled="{{busy}}" borderless bind:change="inputUsername" class="input-username"/><view class="field-rule"/><t-input label="密码" value="{{password}}" placeholder="输入密码" type="password" maxlength="128" disabled="{{busy}}" borderless bind:change="inputPassword" bind:enter="submitAccount" class="input-password"/></view><t-button theme="primary" size="large" block bind:tap="submitAccount" disabled="{{busy}}" loading="{{busy}}" class="action-submitAccount">登录</t-button><view class="login-separator"><text/><text>或使用已绑定的微信</text><text/></view><t-button theme="light" size="large" block icon="logo-wechat-stroke" bind:tap="submitLandlordWeChat" disabled="{{busy}}" class="action-submitLandlordWeChat">微信快捷登录</t-button></block>
 <block wx:else><view class="panel-title">你的租住，一处查看</view><view class="support tenant-intro">使用微信登录，查看房屋、账单与合同。</view><block wx:if="{{phoneRequired}}"><view class="support">首次登录，请填写联系手机号</view><view class="login-fields"><t-input label="手机号" type="number" value="{{phone}}" maxlength="11" placeholder="输入11位手机号" borderless disabled="{{busy}}" bind:change="input" class="input-phone"/></view></block><t-button theme="primary" size="large" block icon="logo-wechat-stroke" bind:tap="submit" disabled="{{busy}}" loading="{{busy}}" class="action-submit">{{phoneRequired ? '提交入住登记' : '微信登录'}}</t-button><view class="login-help">首次登记后，由房东核对并关联租住档案。</view></block>
 <view wx:if="{{error}}" class="login-error">{{error}}</view></view>
 <view class="login-footer"><t-icon name="lock-on" size="13px"/>仅向你展示本人或获授权的租务资料</view>
</view>
