<view class="page login">
  <view class="brand">Landlord · 租务</view>
  <view class="actions"><button class="small {{mode === 'tenant' ? 'primary' : ''}}" data-mode="tenant" bindtap="switchMode" disabled="{{busy}}">我是租客</button><button class="small {{mode === 'landlord' ? 'primary' : ''}}" data-mode="landlord" bindtap="switchMode" disabled="{{busy}}">我是房东</button></view>
  <block wx:if="{{mode === 'landlord'}}">
    <view class="title">房东账号登录</view><view class="subtitle">使用现有 Web 账号，管理你有权限的台账。</view>
    <label class="label-input">账号<input aria-label="房东账号" value="{{username}}" bindinput="inputUsername" maxlength="128" placeholder="现有账号" disabled="{{busy}}" /></label>
    <label class="label-input">密码<input aria-label="房东密码" password value="{{password}}" bindinput="inputPassword" maxlength="128" placeholder="输入账号密码" disabled="{{busy}}" /></label>
    <view wx:if="{{error}}" class="login-error">{{error}}</view>
    <button class="primary" bindtap="submitAccount" loading="{{busy}}" disabled="{{busy}}">登录房东工作台</button>
    <view class="footer-note">使用已开通的账号登录。新账号开通与复杂操作请在 Web 完成。</view>
  </block>
  <block wx:else>
  <view class="title">{{phoneRequired ? '填写入住手机号' : '欢迎回家'}}</view>
  <view class="subtitle">{{phoneRequired ? '填写登记给房东的手机号，方便房东核对并关联你的租住档案。' : '使用微信登录，查看你的房屋、合同与每一笔账单。'}}</view>
  <label wx:if="{{phoneRequired}}" class="label-input">入住手机号<input aria-label="入住手机号" type="number" value="{{phone}}" bindinput="input" maxlength="11" placeholder="填写入住时登记的手机号" disabled="{{busy}}" /></label>
  <view wx:if="{{error}}" class="login-error">{{error}}</view>
  <button class="primary gap" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{phoneRequired ? '确认手机号并继续' : '微信登录'}}</button>
  <view class="footer-note">首次登录需由房东确认关联，之后可直接使用微信登录。</view>
  </block>
</view>
