<view class="mist"/><t-navbar placeholder="{{true}}" id="app-header" title="线下实收" left-arrow="{{true}}" delta="{{0}}" bind:go-back="goBack" />
<import src="../../../templates/landlord.wxml" />
<view class="page payment-page">
  <template is="landlord-scope" data="{{username, ledgers, ledgerIndex, ledgerName, loading, busy}}" />
  <view class="subtitle">登记已经收到的款项，生成本笔收据。</view>
  <view wx:if="{{loading}}" class="loading">正在核对账单与实收…</view><view wx:elif="{{error}}" class="error">{{error}}<t-button theme="light" size="large" block bind:tap="refresh" class="action-refresh">重新读取</t-button></view>
  <block wx:elif="{{bill}}">
    <view class="surface"><view class="room">{{bill.room_no}} · {{bill.period}}</view><view class="meta">{{bill.tenant_name}}</view><view class="pair"><text>本期应缴</text><text>¥{{bill.payableText}}</text></view><view class="pair"><text>累计净实收</text><text>¥{{bill.paidText}}</text></view><view class="pair"><text>尚欠</text><text>¥{{bill.dueText}}</text></view></view>
    <view wx:if="{{blocked}}" class="note">{{message}}<t-button theme="light" size="large" block class="action-goHome gap" bind:tap="goHome">回工作台核对原请求</t-button></view>
    <block wx:elif="{{!finished}}">
      <view wx:if="{{!canEdit}}" class="hint">当前台账只有查看权限，无法登记或重试实收。</view>
      <view class="payment-amount-label">本次已收到</view><view class="payment-amount-field"><text>¥</text><t-input borderless  type="digit" data-field="amount" value="{{amount}}" bind:change="input" t-class-input="payment-number-input" placeholder="0.00" disabled="{{busy || pending || !canEdit}}"   class="input-amount"/></view>
      <label class="label-input">备注（可选，最多500字）<t-input borderless  data-field="note" value="{{note}}" bind:change="input" maxlength="500" placeholder="例如 线下转账" disabled="{{busy || pending || !canEdit}}"   class="input-note"/></label>
      <t-button theme="light" size="large" block wx:if="{{canEdit && !pending && !reviewed}}" class="action-reviewPayment gap review-payment" bind:tap="reviewPayment" disabled="{{busy}}" loading="{{busy}}">核对本次实收</t-button>
      <view wx:if="{{reviewed || retryReady}}" class="surface"><view>本次登记 ¥{{reviewedAmount}}</view><view wx:if="{{overpay}}" class="note">本次含超过账单应缴的预收，请核对金额。是否抵扣后续账期取决于台账结转设置。</view><view class="hint">请确认已实际收到款项。登记后保留原始流水与收据，更正请在Web办理冲销。</view></view>
      <t-button theme="primary" size="large" block wx:if="{{canEdit && reviewed && !pending}}" class="action-submit primary gap submit-payment" bind:tap="submit" disabled="{{busy}}" loading="{{busy}}">确认已收款 · ¥{{reviewedAmount}}</t-button>
      <block wx:if="{{pending}}"><view class="note">结果未确认前，这一笔金额和备注会临时保存在本机，以便关闭后继续核对；核对成功或退出账号后清除。</view><t-button theme="light" size="large" block class="action-checkPayment gap check-payment" bind:tap="checkPayment" disabled="{{busy}}" loading="{{busy}}">核对本笔实收</t-button><t-button theme="primary" size="large" block wx:if="{{canEdit && retryReady}}" class="action-retry primary gap retry-payment" bind:tap="retry" disabled="{{busy}}">按原请求确认登记 · ¥{{reviewedAmount}}</t-button></block>
    </block>
    <view wx:if="{{formError}}" class="login-error">{{formError}}</view><view wx:if="{{message && !blocked}}" class="note">{{message}}</view>
    <t-button theme="light" size="large" block wx:if="{{finished && canEdit}}" class="action-newPayment gap" bind:tap="newPayment" disabled="{{busy || opening}}">登记另一笔实收</t-button>
    <view class="section-title">{{finished ? '本次核对的原始流水' : '逐笔实收与冲销'}}</view>
    <view wx:if="{{!payments.length}}" class="surface empty">暂无实收记录。</view>
    <view wx:for="{{payments}}" wx:key="id" class="surface"><view class="row"><text>{{item.kindText}} · {{item.stateText}}</text><text class="money">{{item.kindText === '冲销' ? '-' : '+'}} ¥{{item.amountText}}</text></view><view class="meta gap">{{item.dateText}}</view><view wx:if="{{item.note}}" class="note">{{item.note}}</view><view wx:if="{{item.voided_at}}" class="note negative">已冲销 · {{item.void_reason}}</view><t-button theme="light" size="large" block wx:if="{{item.receipt_id}}" class="action-openReceipt gap open-receipt" bind:tap="openReceipt" data-id="{{item.receipt_id}}" disabled="{{busy || opening}}">查看{{item.stateText}}</t-button><view wx:else class="hint">历史流水尚无归档PDF</view></view>
    <view class="hint">本页不提供在线支付。这里登记整笔实收；按收费项目分摊、冲销与退款核对请在Web完成。</view>
  </block>
</view>
