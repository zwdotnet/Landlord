<import src="../../../templates/landlord.wxml" />
<view class="page">
  <template is="landlord-scope" data="{{username, ledgers, ledgerIndex, ledgerName, loading}}" />
  <view class="title gap">房东工作台</view><view class="subtitle">查看房源与账单，掌握当前台账的租务。</view>
  <view wx:if="{{loading}}" class="loading">正在读取台账…</view><view wx:elif="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view>
  <block wx:else>
    <view wx:if="{{!hasLedger}}" class="surface empty">暂无可用台账，请在 Web 开通或联系台账管理者。</view>
    <view wx:elif="{{!canRooms && !canBills}}" class="surface empty">当前台账暂未授予房源或账单查看权限。</view>
    <button wx:if="{{canRooms}}" class="surface link-row" bindtap="goRooms">房源查询<text class="arrow">›</text></button>
    <button wx:if="{{canBills}}" class="surface link-row" bindtap="goBills">账单查询<text class="arrow">›</text></button>
    <view class="hint">新增、编辑、抄表及收款请继续使用 Web。小程序显示的数据与 Web 保持一致。</view>
  </block>
  <button class="quiet gap" bindtap="logout">退出登录 / 切换账号</button>
</view>
