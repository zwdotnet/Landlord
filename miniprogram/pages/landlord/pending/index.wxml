<view class="mist"/><t-navbar placeholder="{{true}}" id="app-header" title="账号审核" left-arrow="{{false}}" delta="{{0}}" bind:go-back="goBack" />
<view class="page"><view class="kicker">Landlord · 房东</view><view class="subtitle">{{username}}，账号尚未开通业务权限，请联系平台管理员。</view><view wx:if="{{error}}" class="error">{{error}}</view><t-button theme="primary" size="large" block class="action-refresh primary gap" bind:tap="refresh" loading="{{loading}}" disabled="{{loading}}">刷新审核状态</t-button><t-button theme="light" size="large" block class="action-goAccount gap" bind:tap="goAccount">微信绑定</t-button><t-button theme="light" size="large" block class="action-logout quiet gap" bind:tap="logout">退出登录 / 切换账号</t-button></view>
