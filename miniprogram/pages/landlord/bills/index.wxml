<view class="mist"/><t-navbar placeholder="{{true}}" id="app-header" title="账单" left-arrow="{{false}}" delta="{{0}}" bind:go-back="goBack" />
<import src="../../../templates/landlord.wxml" />
<view class="page with-tabs"><template is="landlord-scope" data="{{username, ledgers, ledgerIndex, ledgerName, loading}}" />
  <view class="search-row"><t-input borderless  aria-label="搜索账单" value="{{keyword}}" bind:change="inputKeyword" bind:enter="search" confirm-type="search" placeholder="搜索房号 / 租客"   class="input-field"/><t-button theme="light" size="small" class="action-search small" bind:tap="search" disabled="{{loading}}">搜索</t-button></view>
  <view wx:if="{{loading}}" class="loading">正在读取账单…</view><view wx:elif="{{error}}" class="error">{{error}}<t-button theme="light" size="large" block bind:tap="refresh" class="action-refresh">重新加载</t-button></view>
  <block wx:else><view class="meta gap">共 {{total}} 张账单</view><view wx:if="{{!items.length}}" class="surface empty">暂无符合条件的账单。</view>
    <view wx:for="{{items}}" wx:key="id" class="surface" bindtap="goBill" data-id="{{item.id}}"><view class="row"><view class="list-title">{{item.room_no}} · {{item.period}}</view><text class="badge {{item.status === 'paid' ? 'paid' : ''}}">{{item.statusText}}</text></view><view class="meta gap">{{item.tenant_name}}</view><view class="pair"><text class="label">本期应缴</text><text class="money">¥{{item.payableText}}</text></view><view class="pair"><text class="label">尚欠</text><text>¥{{item.dueText}}</text></view></view>
    <view wx:if="{{pages > 1}}" class="pagination"><t-button theme="light" size="small" class="action-previous small" bind:tap="previous" disabled="{{page <= 1}}">上一页</t-button><text class="meta">{{page}} / {{pages}}</text><t-button theme="light" size="small" class="action-next small" bind:tap="next" disabled="{{page >= pages}}">下一页</t-button></view>
  </block></view>


<app-nav id="app-navigation" role="landlord" current="bills" meters="{{canMeters}}" issue="{{canIssue}}" pending="{{hasPendingPayment}}" />
