<view class="mist"/><t-navbar placeholder="{{true}}" id="app-header" title="抄表录入" left-arrow="{{true}}" delta="{{0}}" bind:go-back="goBack" />
<import src="../../../templates/landlord.wxml" />
<view class="page with-action">
  <template is="landlord-scope" data="{{username, ledgers, ledgerIndex, ledgerName, loading, busy}}" />
  <view class="subtitle">按房源和账期记录水、电、燃气读数。</view>
  <picker mode="date" fields="month" value="{{period}}" bindchange="changePeriod" disabled="{{busy || contextLoading || loading}}"><view class="surface row"><text>账期</text><text>{{period}}　⌄</text></view></picker>
  <view wx:if="{{!room}}" class="search-row"><t-input borderless  aria-label="搜索抄表房源" value="{{keyword}}" bind:change="inputKeyword" bind:enter="search" placeholder="搜索房号 / 小区" disabled="{{busy || loading}}"   class="input-field"/><t-button theme="light" size="small" class="action-search small" bind:tap="search" disabled="{{busy || loading}}">搜索房源</t-button></view>
  <view wx:if="{{loading}}" class="loading">正在读取台账和房源…</view>
  <view wx:elif="{{error}}" class="error">{{error}}<t-button theme="light" size="large" block bind:tap="refresh" class="action-refresh">重新加载</t-button></view>
  <block wx:else>
    <view wx:if="{{!room && !items.length}}" class="surface empty">暂无可抄表房源。</view>
    <block wx:if="{{!room && items.length}}">
      <view class="meta gap">共 {{total}} 间房源 · 点击选择</view>
      <view class="room-grid"><view wx:for="{{items}}" wx:key="id" class="room-choice {{room && room.id === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseRoom"><view class="row-title">{{item.room_no}}</view><view class="meta">{{item.community}} {{item.building}}</view></view></view>
      <view wx:if="{{pages > 1}}" class="pagination"><t-button theme="light" size="small" class="action-previousPage small" bind:tap="previousPage" disabled="{{busy || page <= 1}}">上一页</t-button><text class="meta">{{page}} / {{pages}}</text><t-button theme="light" size="small" class="action-nextPage small" bind:tap="nextPage" disabled="{{busy || page >= pages}}">下一页</t-button></view>
    </block>
    <view wx:if="{{contextLoading}}" class="loading">正在读取该房的抄表记录…</view>
    <view wx:if="{{room}}" class="white-panel selected-room"><view class="room-icon"><t-icon name="home" size="25px"/></view><view class="row-copy"><view class="row-title">{{room.room_no}} · {{period}}</view><view class="support">{{room.community}} {{room.building}}</view></view><t-button theme="light" size="small" class="action-changeRoom" bind:tap="changeRoom" disabled="{{busy || contextLoading}}">更换</t-button></view>
    <block wx:if="{{formReady}}">
      <view wx:if="{{!canEdit}}" class="hint">当前台账只有抄表查看权限，不能保存读数。</view>
      <view class="white-panel meter-card"><view class="spread"><view class="meter-label"><view class="meter-icon water"><t-icon name="dashboard" size="17px"/></view>水表</view><text class="unit">m³</text></view><view class="meter-field"><t-input aria-label="水表读数" borderless type="digit" value="{{water}}" data-field="water" bind:change="inputReading" maxlength="32" disabled="{{!canEdit || busy || needsCheck}}" t-class-input="meter-number-input" placeholder="本期读数" class="input-water"/></view><view class="meter-comparison"><text>{{previous.is_initial ? '初始' : '上期'}} {{previous.water}}</text><text>{{currentRecord ? '已载入本期记录' : '本期待录入'}}</text></view></view>
      <view class="white-panel meter-card"><view class="spread"><view class="meter-label"><view class="meter-icon power"><t-icon name="lighting-circle" size="17px"/></view>电表</view><text class="unit">kW·h</text></view><view class="meter-field"><t-input aria-label="电表读数" borderless type="digit" value="{{elec}}" data-field="elec" bind:change="inputReading" maxlength="32" disabled="{{!canEdit || busy || needsCheck}}" t-class-input="meter-number-input" placeholder="本期读数" class="input-elec"/></view><view class="meter-comparison"><text>{{previous.is_initial ? '初始' : '上期'}} {{previous.elec}}</text><text>{{currentRecord ? '已载入本期记录' : '本期待录入'}}</text></view></view>
      <view class="white-panel meter-card"><view class="spread"><view class="meter-label"><view class="meter-icon gas"><t-icon name="dashboard" size="17px"/></view>燃气表</view><text class="unit">m³</text></view><view class="meter-field"><t-input aria-label="燃气表读数" borderless type="digit" value="{{gas}}" data-field="gas" bind:change="inputReading" maxlength="32" disabled="{{!canEdit || busy || needsCheck}}" t-class-input="meter-number-input" placeholder="本期读数" class="input-gas"/></view><view class="meter-comparison"><text>{{previous.is_initial ? '初始' : '上期'}} {{previous.gas}}</text><text>{{currentRecord ? '已载入本期记录' : '本期待录入'}}</text></view></view>
      <label class="label-input">备注（选填）<t-input borderless  aria-label="抄表备注" value="{{note}}" data-field="note" bind:change="inputReading" maxlength="500" disabled="{{!canEdit || busy || needsCheck}}"   class="input-note"/></label>
      <view wx:if="{{lowerReading}}" class="login-error">读数低于上期，请确认换表或输入是否正确；自动出账可能需要人工核对。</view>
      <view wx:if="{{billExists}}" class="hint">本期已出账。修改抄表不会改写已出账单，费用调整请在 Web 核对处理。</view>
      <view class="hint">已启用周期计划的房源，补齐抄表后会按现有计划自动出账；未启用的房源只保存读数。</view>
    </block>
    <view wx:if="{{formError}}" class="login-error">{{formError}}</view>
    <view wx:if="{{serverReading}}" class="surface">服务器当前：{{serverReading}}</view>
    <view wx:if="{{message}}" class="hint">{{message}}</view>


    <t-button theme="light" size="large" block wx:if="{{room && !needsCheck || conflict}}" class="action-reloadContext quiet gap" bind:tap="reloadContext" disabled="{{busy || contextLoading}}">{{conflict ? '载入服务器记录，重新修改' : '重新载入本期读数'}}</t-button>
    <view class="hint">切换房源、账期或离开页面会清空未保存的输入。</view>
  </block>
</view>

<view wx:if="{{!loading && !error && (formReady && canEdit && !needsCheck || needsCheck)}}" class="bottom-action"><t-button theme="primary" size="large" block wx:if="{{formReady && canEdit && !needsCheck}}" class="action-save primary gap save-reading" bind:tap="save" disabled="{{busy}}" loading="{{busy}}">{{lowerReading ? '确认保存（读数低于上期）' : '保存并回查读数'}}</t-button><t-button theme="primary" size="large" block wx:if="{{needsCheck}}" class="action-checkSaved primary gap" bind:tap="checkSaved" disabled="{{busy}}" loading="{{busy}}">核对服务器记录</t-button></view>
