<view class="mist"/><t-navbar placeholder="{{true}}" id="app-header" title="我的" left-arrow="{{false}}" delta="{{0}}" bind:go-back="goBack" />
<view class="page with-tabs">
  <view class="profile-header"><view class="avatar profile-avatar"><t-icon name="user" size="35px"/></view><view class="profile-name">{{username || '房东账号'}}</view><view class="profile-account">房东 · 账号与微信绑定</view></view>
  <view wx:if="{{loading}}" class="loading">正在读取绑定状态…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{ready}}">

    <view class="surface gap">{{bound ? (currentApp ? '账号已绑定微信' : '账号已绑定其他小程序') : '账号尚未绑定微信'}}</view>
    <view wx:if="{{!bound && status === 2}}" class="hint">账号审核通过后可绑定微信。</view>
    <view wx:elif="{{!bound && !available}}" class="hint">微信绑定暂未配置，请继续使用账号密码登录。</view>
    <block wx:if="{{bound || (available && status === 1)}}">
      <view class="hint">{{bound ? '解绑后将撤销所有已签发的登录令牌（含 Web），当前页面也会退出。账号及租务资料保留，可用密码重新登录。' : '绑定当前微信后，可使用同一个房东账号快捷登录。已关联租客或其他账号的微信不能重复绑定。'}}</view>
      <label class="label-input">当前账号密码<t-input borderless  aria-label="确认账号密码" type="password" value="{{password}}" bind:change="inputPassword" maxlength="128" disabled="{{busy}}" placeholder="验证本人操作"   class="input-field"/></label>
      <t-button theme="primary" size="large" block wx:if="{{!bound}}" class="action-bind primary gap" bind:tap="bind" disabled="{{busy}}" loading="{{busy}}">确认绑定当前微信</t-button>
      <t-button theme="light" size="large" block wx:else class="action-unbind gap" bind:tap="unbind" disabled="{{busy}}" loading="{{busy}}">确认解绑并退出登录</t-button>
    </block>
    <view wx:if="{{message}}" class="hint">{{message}}</view>
  </block>
  <t-button theme="light" size="large" block class="action-refresh quiet gap" bind:tap="refresh" disabled="{{busy || loading}}">刷新绑定状态</t-button>
</view>


<app-nav id="app-navigation" role="landlord" current="account" meters="{{canMeters}}" issue="{{canIssue}}" pending="{{hasPendingPayment}}" />
