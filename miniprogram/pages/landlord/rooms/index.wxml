<view class="mist"/><t-navbar placeholder="{{true}}" id="app-header" title="房源" left-arrow="{{false}}" delta="{{0}}" bind:go-back="goBack" />
<import src="../../../templates/landlord.wxml" />
<view class="page with-tabs"><template is="landlord-scope" data="{{username, ledgers, ledgerIndex, ledgerName, loading}}" />
  <view class="search-row"><t-input borderless  aria-label="搜索房源" value="{{keyword}}" bind:change="inputKeyword" bind:enter="search" confirm-type="search" placeholder="搜索房号 / 小区"   class="input-field"/><t-button theme="light" size="small" class="action-search small" bind:tap="search" disabled="{{loading}}">搜索</t-button></view>
  <view wx:if="{{loading}}" class="loading">正在读取房源…</view><view wx:elif="{{error}}" class="error">{{error}}<t-button theme="light" size="large" block bind:tap="refresh" class="action-refresh">重新加载</t-button></view>
  <block wx:else><view class="meta gap">共 {{total}} 间房源</view><view wx:if="{{!items.length}}" class="surface empty">暂无符合条件的房源。</view>
    <view wx:for="{{items}}" wx:key="id" class="surface"><view class="row"><view class="list-title">{{item.room_no}}</view><text class="badge {{item.occupied ? 'paid' : ''}}">{{item.occupied ? '在租' : '空置'}}</text></view><view class="meta gap">{{item.community}} {{item.building}}</view><view wx:if="{{item.address}}" class="note">{{item.address}}</view><view class="pair"><text class="label">默认月租</text><text class="money">¥{{item.rentText}}</text></view></view>
    <view wx:if="{{pages > 1}}" class="pagination"><t-button theme="light" size="small" class="action-previous small" bind:tap="previous" disabled="{{page <= 1}}">上一页</t-button><text class="meta">{{page}} / {{pages}}</text><t-button theme="light" size="small" class="action-next small" bind:tap="next" disabled="{{page >= pages}}">下一页</t-button></view>
  </block></view>


<app-nav id="app-navigation" role="landlord" current="rooms" meters="{{canMeters}}" issue="{{canIssue}}" pending="{{hasPendingPayment}}" />
