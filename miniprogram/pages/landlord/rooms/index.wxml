<import src="../../../templates/landlord.wxml" />
<view class="page"><template is="landlord-scope" data="{{username, ledgers, ledgerIndex, ledgerName, loading}}" /><view class="title gap">房源查询</view>
  <view class="row"><input aria-label="搜索房源" value="{{keyword}}" bindinput="inputKeyword" bindconfirm="search" confirm-type="search" placeholder="搜索房号 / 小区" /><button class="small" bindtap="search" disabled="{{loading}}">搜索</button></view>
  <view wx:if="{{loading}}" class="loading">正在读取房源…</view><view wx:elif="{{error}}" class="error">{{error}}<button bindtap="refresh">重新加载</button></view>
  <block wx:else><view class="meta gap">共 {{total}} 间房源</view><view wx:if="{{!items.length}}" class="surface empty">暂无符合条件的房源。</view>
    <view wx:for="{{items}}" wx:key="id" class="surface"><view class="row"><view class="list-title">{{item.room_no}}</view><text class="badge {{item.occupied ? 'paid' : ''}}">{{item.occupied ? '在租' : '空置'}}</text></view><view class="meta gap">{{item.community}} {{item.building}}</view><view wx:if="{{item.address}}" class="note">{{item.address}}</view><view class="pair"><text class="label">默认月租</text><text class="money">¥{{item.rentText}}</text></view></view>
    <view wx:if="{{pages > 1}}" class="pagination"><button class="small" bindtap="previous" disabled="{{page <= 1}}">上一页</button><text class="meta">{{page}} / {{pages}}</text><button class="small" bindtap="next" disabled="{{page >= pages}}">下一页</button></view>
  </block></view>
