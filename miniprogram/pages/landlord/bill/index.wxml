<import src="../../../templates/landlord.wxml" />
<view class="page"><template is="landlord-scope" data="{{username, ledgers, ledgerIndex, ledgerName, loading}}" /><view class="title gap">账单明细</view>
  <view wx:if="{{loading}}" class="loading">正在读取明细…</view><view wx:elif="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button><button bindtap="goBills">返回账单查询</button></view>
  <block wx:elif="{{bill}}"><view class="kicker">{{bill.room_no}} · {{bill.period}}</view><view class="hero"><view class="row"><text>本期应缴</text><text class="badge">{{bill.statusText}}</text></view><view class="amount gap">¥{{bill.payableText}}</view><view class="pair"><text class="label">本期费用</text><text>¥{{bill.totalText}}</text></view><view class="pair"><text class="label">上期结转</text><text>¥{{bill.carryText}}</text></view><view class="pair"><text class="label">已收</text><text>¥{{bill.paidText}}</text></view><view class="pair"><text class="label">尚欠</text><text>¥{{bill.dueText}}</text></view></view>
    <view class="section-title">费用明细</view><view class="surface"><view wx:for="{{items}}" wx:key="key" class="gap"><view class="row top"><view class="grow">{{item.name}}<view class="meta">{{item.detail}}</view></view><text class="money">¥{{item.amountText}}</text></view></view><view wx:if="{{!items.length}}" class="meta">暂无分项明细</view></view>
    <view class="section-title">逐笔实收与冲销</view><view wx:if="{{!payments.length}}" class="surface empty">尚无收款记录。</view><view wx:for="{{payments}}" wx:key="id" class="surface"><view class="row"><text>{{item.kindText}} · {{item.stateText}}</text><text class="money">{{item.kindText === '冲销' ? '-' : '+'}} ¥{{item.amountText}}</text></view><view class="meta gap">{{item.dateText}}</view><view wx:if="{{item.note}}" class="note">{{item.note}}</view></view>
    <button wx:if="{{canIssue}}" class="primary gap" bindtap="goPay">登记线下实收</button>
    <view wx:for="{{payments}}" wx:key="id"><button wx:if="{{item.receipt_id}}" class="gap" bindtap="openReceipt" data-id="{{item.receipt_id}}" disabled="{{opening}}">查看第{{item.id}}笔{{item.stateText}}</button></view>
    <view class="hint">逐笔收据读取归档原件；按项目分摊及冲销请在 Web 完成。</view></block>
</view>
