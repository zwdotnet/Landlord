<view class="mist"/><t-navbar placeholder="{{true}}" id="app-header" title="账单明细" left-arrow="{{true}}" delta="{{0}}" bind:go-back="goBack" />
<import src="../../../templates/landlord.wxml"/><view class="screen with-action"><template is="landlord-scope" data="{{username,ledgers,ledgerIndex,ledgerName,loading}}"/><view wx:if="{{loading}}" class="loading">正在读取账单…</view><view wx:elif="{{error}}" class="error">{{error}}<t-button bind:tap="refresh" class="action-refresh">重试</t-button></view><block wx:elif="{{bill}}">
     <view class="bill-overview glass"><view class="spread"><view class="status-pill">{{bill.statusText}}</view><view class="quiet-chip">{{bill.period}}</view></view><view class="bill-amount-label">本期应缴</view><view class="hero-money"><text class="money-symbol">¥</text>{{bill.payableText}}</view><view class="bill-place">{{bill.room_no}}<text>{{bill.tenant_name}}</text></view></view>
     <view class="section-heading">费用明细</view><view class="white-panel fee-panel"><view wx:for="{{items}}" wx:key="key" class="fee-row"><view class="row-copy"><view class="row-title">{{item.name}}</view><view class="support">{{item.detail}}</view></view><view class="fee-value">¥{{item.amountText}}</view></view><view wx:if="{{!items.length}}" class="hint">暂无分项明细</view><view class="full-rule"/><view class="fee-summary"><text>本期费用</text><text>¥{{bill.totalText}}</text></view><view class="fee-summary"><text>上期结转</text><text>¥{{bill.carryText}}</text></view><view class="fee-summary total"><text>本期合计</text><text>¥{{bill.payableText}}</text></view></view>
     <view class="section-heading">收款情况</view><view class="white-panel received-panel"><view class="spread"><text class="support">累计净实收</text><text class="row-amount">¥{{bill.paidText}}</text></view><view class="spread due-line"><text>尚待收款</text><text class="due-amount">¥{{bill.dueText}}</text></view></view>
     <view wx:if="{{bill.rent_calculation}}" class="surface"><view class="row-title">{{bill.rent_basis_source === 'current_lease_reference' ? '租金计算参考（按当前档案）' : '租金计算依据'}}</view><view class="meta gap">{{bill.rent_start_date}} — {{bill.rent_end_date}}</view><view class="note">{{bill.rent_calculation}}</view></view>
     <view class="section-heading">逐笔实收与冲销</view><view wx:if="{{!payments.length}}" class="empty">尚无收款记录</view><view wx:for="{{payments}}" wx:key="id" class="surface"><view class="spread"><text>{{item.kindText}} · {{item.stateText}}</text><text class="money {{item.kindText === '冲销' ? 'negative' : 'positive'}}">{{item.kindText === '冲销' ? '-' : '+'}} ¥{{item.amountText}}</text></view><view class="meta gap">{{item.dateText}}</view><view wx:if="{{item.note}}" class="note">{{item.note}}</view><view wx:if="{{item.voided_at}}" class="note negative">已冲销 · {{item.void_reason}}</view><t-button wx:if="{{item.receipt_id}}" theme="light" size="small" class="action-openReceipt gap" bind:tap="openReceipt" data-id="{{item.receipt_id}}" disabled="{{opening}}">查看{{item.stateText}}</t-button><view wx:else class="hint">历史流水尚无归档PDF</view></view>
     <view wx:if="{{bill.remark}}" class="surface"><view class="meta">账单备注</view><view class="note">{{bill.remark}}</view></view><view class="hint">本期应缴包含上期结转；实收与冲销均保留原流水。</view></block></view>
<view wx:if="{{bill && !loading && !error && canIssue}}" class="bottom-action bill-action"><view class="bill-action-sum"><text>待收</text><view>¥{{bill.dueText}}</view></view><view class="bill-action-button"><t-button theme="primary" size="large" block bind:tap="goPay" class="action-goPay">登记实收</t-button></view></view>
