page{background:#f5f7f5;color:#202e26;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:30rpx;line-height:1.6}
view,text,button,input{box-sizing:border-box}
button{font-size:28rpx;border-radius:16rpx;line-height:1.5;margin:0;padding:22rpx 28rpx;background:#edf2ee;color:#245c45;font-weight:600}
button::after{border:0}button[disabled]{background:#e5eae6;color:#819086}
button.primary{background:#245c45;color:white}button.primary[disabled]{background:#8da99b}
button.quiet{background:transparent;color:#52685b;font-weight:400}button.small{font-size:25rpx;padding:14rpx 20rpx}
.page{padding:32rpx 32rpx calc(42rpx + env(safe-area-inset-bottom))}
.kicker{font-size:24rpx;color:#627368;letter-spacing:2rpx}.title{font-size:48rpx;font-weight:650;line-height:1.3;margin:10rpx 0 18rpx}
.subtitle{font-size:27rpx;color:#627368;line-height:1.7}.section-title{font-size:32rpx;font-weight:600;margin:40rpx 0 18rpx}
.surface{background:#fff;border-radius:24rpx;padding:28rpx;margin-top:22rpx;overflow:hidden}.hero{background:#e5eee6;border:1rpx solid #d7e4d9;padding:36rpx;border-radius:26rpx;margin-top:24rpx}
.room{font-size:39rpx;line-height:1.4;font-weight:600;word-break:break-all}.hero .subtitle{margin-top:14rpx}
.row{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.top{align-items:flex-start}.grow{flex:1;min-width:0}
.meta{font-size:25rpx;color:#67786b}.amount{font-size:52rpx;font-weight:650;letter-spacing:-1rpx;font-variant-numeric:tabular-nums;word-break:break-all;line-height:1.3}.currency{font-size:28rpx;margin-right:6rpx}
.money{font-variant-numeric:tabular-nums;font-weight:600;white-space:nowrap}.negative{color:#a23c38}.positive{color:#245c45}
.badge{font-size:23rpx;line-height:1.5;flex-shrink:0;color:#7f5b1d;background:#f6efd9;padding:6rpx 15rpx;border-radius:8rpx}.badge.paid{background:#e7f1e8;color:#245c45}
.rule{height:1rpx;background:#edf0ed;margin:24rpx 0}.pair{display:flex;justify-content:space-between;align-items:flex-start;gap:24rpx;padding:13rpx 0;font-size:28rpx}.pair .label{color:#67786b;flex-shrink:0}.pair .value{text-align:right;word-break:break-all}
.actions{display:flex;gap:16rpx;margin-top:28rpx;flex-wrap:wrap}.actions button{flex:1;min-width:200rpx}.list-title{font-size:31rpx;font-weight:600;word-break:break-all}.gap{margin-top:16rpx}.hint{font-size:25rpx;color:#67786b;margin-top:22rpx;line-height:1.8}.link-row{padding:24rpx 0;display:flex;align-items:center;justify-content:space-between;font-size:30rpx}.arrow{color:#7b8c7e;font-size:35rpx}
.empty,.loading,.error{padding:56rpx 24rpx;text-align:center;color:#67786b;font-size:28rpx}.error{color:#99463d}.error button{margin:24rpx auto 0;max-width:340rpx}.empty-title{color:#283d2e;font-size:34rpx;font-weight:600;margin-bottom:14rpx}
.note{white-space:pre-wrap;word-break:break-all;font-size:27rpx;color:#607365;margin-top:12rpx}.label-input{display:block;margin-top:28rpx;font-size:27rpx;color:#4b6152}
input{background:#fff;border:1rpx solid #d6dfd7;border-radius:14rpx;padding:24rpx;height:96rpx;margin-top:12rpx;font-size:32rpx;width:100%}
.login{padding-top:64rpx}.brand{font-size:27rpx;font-weight:600;color:#245c45;letter-spacing:1rpx}.login .title{font-size:56rpx;margin-top:44rpx}.login .primary{margin-top:38rpx;width:100%}
.login-error{font-size:27rpx;color:#99463d;margin-top:24rpx}.footer-note{font-size:24rpx;color:#758176;text-align:center;margin-top:48rpx}.pagination{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:28rpx}.pagination .meta{text-align:center}
